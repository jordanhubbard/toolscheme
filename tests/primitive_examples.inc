{"write-file", "(write-file \"written.txt\" \"x\")", "(write-file \"../escape.txt\" \"x\")"},
{"write-to-string", "(write-to-string '(1 2))", "(write-to-string)"},
{"xargs", "(xargs '(\"a\" \"b\") '((max-arguments 1)))", "(xargs '(\"a\") '((max-arguments 0)))"},
{"yes", "(yes \"y\" '((count 2)))", "(yes \"y\" '((count 99999999)))"},
{"zero?", "(zero? 0)", "(zero? \"x\")"},
{"zip", "(zip '((operation list) (archive \"x.zip\")))", "(zip clock)"},
{"zsh", "(zsh '((command \"echo hi\")))", "(zsh '())"},
// clang-format on
